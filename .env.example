# Salin menjadi .env (cp .env.example .env), lalu isi. JANGAN commit atau bagikan berkas .env.
# Variabel yang sudah ada di lingkungan tidak ditimpa oleh berkas ini.

# --- Otentikasi Claude: pilih SATU ---
# Langganan Pro/Max: jalankan `chunai auth`, tempel tokennya di sini
CLAUDE_CODE_OAUTH_TOKEN=
# Atau kunci API berbayar (dibatasi di console.anthropic.com):
# ANTHROPIC_API_KEY=

# --- Antarmuka Web ---
CHUNAI_WEB_TOKEN=

# --- Telegram (opsional) ---
# Token dari @BotFather; ID dari @userinfobot. Hanya ID ini yang dilayani. Beberapa ID dipisah koma.
CHUNAI_TELEGRAM_TOKEN=
CHUNAI_TELEGRAM_USERS=

# --- Lainnya ---
CHUNAI_TZ=Asia/Jakarta
# Jumlah pekerjaan berat (Chromium/LibreOffice/ffmpeg) bersamaan. 1 aman untuk RAM 4-8 GB.
CHUNAI_HEAVY_SLOTS=1
# Domain yang boleh dibuka Web Agent tanpa bertanya, dipisah koma:
# CHUNAI_ALLOWED_DOMAINS=contoh.go.id
